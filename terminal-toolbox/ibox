    text = " ".join(pos).strip()
    if not text:
        print("用法：ibox ask <命令或文本>            解释它是什么（需本机有 chat 模型）")
        print("      ibox ask --sum -f 日志.txt       摘要长文本")
        print("      cat 日志.txt | ibox ask --sum    从管道摘要")
        return
    _run_tk(["explain", text])


# ============ hi：我在哪台机器（原 hi.sh 的 Python 版，跨平台） ============
def _os_string():
    if sys.platform == "darwin":
        try:
            name = subprocess.check_output(["sw_vers", "-productName"], text=True).strip()
            ver = subprocess.check_output(["sw_vers", "-productVersion"], text=True).strip()
            return "%s %s" % (name, ver)
        except Exception:
            pass
    return "%s %s" % (platform.system(), platform.release())


def _uptime():
    if sys.platform == "win32":
        try:
            import ctypes
            secs = ctypes.windll.kernel32.GetTickCount64() // 1000
            d, rem = divmod(secs, 86400)
            h, rem = divmod(rem, 3600)
            return "已运行 %d 天 %d 小时 %d 分" % (d, h, rem // 60)
        except Exception:
            return "（未知）"
    try:
        return subprocess.check_output(["uptime"], text=True).strip()
    except Exception:
        return "（未知）"


def _chip_and_mem():
    """芯片型号 + 内存总量（macOS 用 sysctl，Windows 用 ctypes，Linux 读 /proc）。"""
    if sys.platform == "darwin":
        try:
            chip = subprocess.check_output(
                ["sysctl", "-n", "machdep.cpu.brand_string"], text=True).strip()
        except Exception:
            chip = platform.processor() or "未知芯片"
        try:
            b = int(subprocess.check_output(["sysctl", "-n", "hw.memsize"], text=True).strip())
            return chip, "%.0fGB 统一内存" % (b / 1024 ** 3)
        except Exception:
            return chip, "内存未知"
    if sys.platform == "win32":
        chip = platform.processor() or "未知芯片"
        try:
            import ctypes

            class _MS(ctypes.Structure):
                _fields_ = [("dwLength", ctypes.c_ulong),
                            ("dwMemoryLoad", ctypes.c_ulong),
                            ("ullTotalPhys", ctypes.c_ulonglong),
                            ("ullAvailPhys", ctypes.c_ulonglong),
                            ("ullTotalPageFile", ctypes.c_ulonglong),
                            ("ullAvailPageFile", ctypes.c_ulonglong),
                            ("ullTotalVirtual", ctypes.c_ulonglong),
                            ("ullAvailVirtual", ctypes.c_ulonglong),
                            ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]

            ms = _MS()
            ms.dwLength = ctypes.sizeof(_MS)
            ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(ms))
            return chip, "%.0fGB 内存" % (ms.ullTotalPhys / 1024 ** 3)
        except Exception:
            return chip, "内存未知"
    chip = platform.processor() or "未知芯片"
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal"):
                    return chip, "%.0fGB 内存" % (int(line.split()[1]) / 1024 ** 2)
    except OSError:
        pass
    return chip, "内存未知"


def cmd_hi(argv):
    me = os.environ.get("USER") or os.environ.get("USERNAME") or getpass.getuser()
    host = socket.gethostname().split(".")[0]
    print("👋  hi, %s @ %s" % (me, host))
    print("🖥   %s  (%s)" % (_os_string(), platform.machine()))
    print("⏱   %s" % _uptime())
    if argv and argv[0] in ("-v", "--verbose"):
        chip, mem = _chip_and_mem()
        print("🔩  %s  ·  %s" % (chip, mem))


# ============ sync：一键 git 同步（原 gup.sh 的 Python 版） ============
def cmd_sync(argv):
    """把当前 git 仓库的改动提交并推送。

    安全底线照搬 gup.sh：只在当前仓库内操作、绝不 rm / reset、先 --ff-only pull、
    无改动直接退出、无 remote 只做本地提交。
    （提交范围沿用原行为 `git add -A`；如需收紧为「只提交指定文件」，改这一行即可。）
    """
    def run(*cmd, **kw):
        return subprocess.run(cmd, text=True, **kw)

    quiet = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if run("git", "rev-parse", "--is-inside-work-tree", **quiet).returncode != 0:
        print("❌ 当前目录不是 git 仓库。请先 cd 到仓库根目录再跑 ibox sync。")
        return
    root = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    os.chdir(root)
    try:
        branch = subprocess.check_output(["git", "symbolic-ref", "--short", "HEAD"],
                                         text=True, stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError:
        branch = "(游离 HEAD)"
    print("📁 仓库: %s  (分支: %s)" % (root, branch))

    has_remote = bool(subprocess.check_output(["git", "remote"], text=True).strip())

    if not subprocess.check_output(["git", "status", "--porcelain"], text=True).strip():
        print("✅ 没有改动，无需提交。")
        if has_remote:
            run("git", "fetch", "--quiet", **quiet)
        return

    print("📦 将提交以下改动（M 改 / A 加 / D 删 / ?? 未跟踪）：")
    print(subprocess.check_output(["git", "status", "--short"], text=True).rstrip())

    if has_remote:
        print("⬇️  先 git pull --ff-only ...")
        if run("git", "pull", "--ff-only").returncode != 0:
            print("⚠️  pull 失败或冲突。请手动 git pull 解决后再跑 ibox sync。")
            return

    run("git", "add", "-A")
    msg = "auto: 同步于 " + datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    if run("git", "commit", "-m", msg, **quiet).returncode != 0:
        print("⚠️  提交失败（可能没有可提交的内容）。")
        return
    print("✅ 已提交: %s" % msg)

    if not has_remote:
        print("ℹ️  没有配置 remote，仅完成本地提交。")
        print("✅ 完成。")
        return
    has_up = run("git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}",
                 **quiet).returncode == 0
    if not has_up:
        print("ℹ️  当前分支 '%s' 没有 upstream，未自动推送。" % branch)
        print("    首次推送请手动：git push -u origin %s" % branch)
        print("✅ 完成。")
        return
    if run("git", "push").returncode != 0:
        print("⚠️  push 失败（可能被拒绝）。先手动 git pull 合并后再跑 ibox sync。")
        return
    print("⬆️  已推送。")
    print("✅ 完成。")


# ============ card：卡库维护（动态注册机制） ============
# 设计：分类是受控词表，卡片按分类落在固定分区里。
# 加卡不再"甩到文件末尾"，而是由 insert 校验分类后插进对应分区的末尾。
CATEGORY_ORDER = ["硬件与系统信息", "进程与资源", "文件与磁盘", "Shell 与环境",
                  "版本控制", "网络与远程", "AI 工具"]
_REQUIRED_FIELDS = ("别名", "作用", "用法", "示例", "踩坑")


def _cheat_paths():
    """返回 [用户级, 仓库版] 两份数据源路径（用户级在前，它是实际生效的那份）。"""
    return [os.path.expanduser("~/.config/cheat/cheatsheet.md"),
            os.path.join(HERE, "cheatsheet.md")]


def _load_cards():
    """按当前生效的数据源加载卡片（pycheat 的解析器，不复制一份）。"""
    import pycheat as P
    return P.load_cards(P.resolve_sheet())


def _split_blocks(text):
    """把 markdown 切成 [(卡名, 块文本)]，块含 `## 卡名` 到下一张卡之前。

    刻意用 startswith 而非正则 `^## (.+)$` —— 后者作用在多行文本上时，
    `$` 默认不跨行，会匹配失败（已踩过）。
    """
    import re
    out = []
    for p in re.split(r"\n(?=## )", text):
        p = p.strip("\n")
        if p.startswith("## "):
            name = p.split("\n", 1)[0][3:].strip()
            if name:
                out.append((name, p))
    return out


def _field(block, key):
    import re
    m = re.search(r"^-\s*" + key + r"[:：]\s*(.*)$", block, re.M)
    return m.group(1).strip() if m else ""


def _refresh_counts(text):
    """重算每个分区标题里的卡数，避免手工维护（标题是插入锚点，也是目录）。"""
    import re
    lines = text.split("\n")
    sec_idx = [i for i, l in enumerate(lines) if re.match(r"^# \d+\. ", l)]
    for k, i in enumerate(sec_idx):
        end = sec_idx[k + 1] if k + 1 < len(sec_idx) else len(lines)
        n = sum(1 for l in lines[i + 1:end] if l.startswith("## "))
        lines[i] = re.sub(r"（\d+ 张）\s*$", "", lines[i]) + "（%d 张）" % n
    return "\n".join(lines)


def _insert_into(text, pairs):
    """pairs: [(分类, 卡文本)] → 插到各自分区的末尾，返回新文本。"""
    import re
    by_cat = {}
    for cat, blk in pairs:
        by_cat.setdefault(cat, []).append(blk)
    lines = text.split("\n")
    sec = {}
    order = []
    for i, l in enumerate(lines):
        m = re.match(r"^# \d+\. (.+?)（\d+ 张）\s*$", l)
        if m:
            sec[m.group(1).strip()] = i
            order.append(m.group(1).strip())
    bounds = {}
    for k, name in enumerate(order):
        bounds[name] = (sec[name], sec[order[k + 1]] if k + 1 < len(order) else len(lines))
    # 从文件靠后的分区往前插，避免行号错位
    for cat in sorted(by_cat, key=lambda c: -bounds.get(c, (0, 0))[0]):
        if cat not in bounds:
            print("  ⚠️ 找不到分区「%s」，跳过 %d 张" % (cat, len(by_cat[cat])))
            continue
        _, end = bounds[cat]
        ins = []
        for blk in by_cat[cat]:
            ins += ["", blk]
        lines[end:end] = ins
    return _refresh_counts("\n".join(lines))


def cmd_card(argv):
    """ibox card check | list | insert —— 卡库校验、浏览、按分类插入。"""
    if not argv:
        print("ibox card 用法：")
        print("  ibox card check              校验分类合法 / 字段完整 / 卡名唯一")
        print("  ibox card list [--分类 X]    列出卡片（含分类与课卷）")
        print("  ibox card insert <文件>      把文件里的卡按「分类」插进对应分区")
        print("  ibox card insert <文件> --local-only   只写用户级数据源（不放仓库）")
        print("\n可选分类：" + " / ".join(CATEGORY_ORDER))
        return
    sub, rest = argv[0], argv[1:]

    if sub == "check":
        cards = _load_cards()
        problems, seen = [], set()
        for c in cards:
            nm = c["name"]
            cat = c.get("分类", "")
            if not cat:
                problems.append("[%s] 缺「分类」字段" % nm)
            elif cat not in CATEGORY_ORDER:
                problems.append("[%s] 分类值「%s」不在词表内" % (nm, cat))
            if nm in seen:
                problems.append("[%s] 卡名重复" % nm)
            seen.add(nm)
            for f in _REQUIRED_FIELDS:
                if f not in c:
                    problems.append("[%s] 缺字段「%s」" % (nm, f))
        if problems:
            print("⚠️ 发现 %d 个问题：" % len(problems))
            for p in problems:
                print("  - " + p)
        else:
            print("✅ %d 张卡全部合规（分类合法 / 字段完整 / 卡名唯一）" % len(cards))
        cnt = {}
        for c in cards:
            cnt[c.get("分类", "(未分类)")] = cnt.get(c.get("分类", "(未分类)"), 0) + 1
        print("\n各分类卡数：")
        for cat in CATEGORY_ORDER:
            print("  %-16s %d" % (cat, cnt.get(cat, 0)))
        return

    if sub == "list":
        opts, _ = _split_opts(rest, flags_with_value=("--分类", "-c"))
        want = (opts or {}).get("--分类") or (opts or {}).get("-c")
        if want and want not in CATEGORY_ORDER:
            hits = [c for c in CATEGORY_ORDER if want in c]
            if len(hits) != 1:
                print("⚠️ 未知分类「%s」；可选：%s" % (want, " / ".join(CATEGORY_ORDER)))
                return
            want = hits[0]
        cur = None
        for c in _load_cards():
            cat = c.get("分类", "(未分类)")
            if want and cat != want:
                continue
            if cat != cur:
                cur = cat
                print("\n# " + cur)
            print("  %-36s 课卷 %s" % (c["name"], c.get("课卷", "-")))
        return

    if sub == "insert":
        opts, pos = _split_opts(rest, flags_with_value=("--target",), bool_flags=("--local-only",))
        if not pos:
            print("用法：ibox card insert <文件> [--local-only]")
            print("     文件里放若干 `## 卡名` 块，每块必须带 `- 分类: <词表内的值>`")
            return
        try:
            with open(pos[0], encoding="utf-8") as f:
                blocks = _split_blocks(f.read())
        except OSError as e:
            print("（读文件失败：%s）" % e)
            return
        if not blocks:
            print("（文件里没找到 `## 卡名` 块）")
            return
        existing = {c["name"] for c in _load_cards()}
        pairs, bad = [], []
        for name, blk in blocks:
            cat = _field(blk, "分类")
            if cat not in CATEGORY_ORDER:
                bad.append("%s（分类「%s」不在词表内）" % (name, cat or "空"))
                continue
            if name in existing:
                bad.append("%s（卡名已存在）" % name)
                continue
            missing = [f for f in _REQUIRED_FIELDS if not _field(blk, f)]
            if missing:
                bad.append("%s（缺字段：%s）" % (name, "/".join(missing)))
                continue
            pairs.append((cat, blk))
        if bad:
            print("⚠️ 以下卡片未插入：")
            for b in bad:
                print("  - " + b)
            if not pairs:
                return
        targets = _cheat_paths()[:1] if opts.get("--local-only") else _cheat_paths()
        for t in targets:
            try:
                with open(t, encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                continue
            with open(t, "w", encoding="utf-8") as f:
                f.write(_insert_into(text, pairs))
            print("✓ %s：插入 %d 张" % (os.path.basename(os.path.dirname(t)) or t, len(pairs)))
        for cat, blk in pairs:
            print("  · %-34s → %s" % (_field(blk, "分类"), blk.split("\n")[0][3:]))
        return

    print("⚠️ 未知子命令「%s」；用 ibox card 看用法" % sub)


# ============ learn：学习模式（按功能域递进 + 间隔复习 + 目录） ============
def cmd_learn(argv):
    """ibox learn            → 分类目录 + 学习进度
    ibox learn <分类>       → 依次过该分类的卡
    ibox learn --due        → 只过「该复习的」（复用 pycheat 的记忆强度）"""
    import pycheat as P
    opts, pos = _split_opts(argv, bool_flags=("--due", "-d"))
    cards = _load_cards()

    if opts.get("--due") or opts.get("-d"):
        due = P.due_for_review(cards)
        if not due:
            print("✅ 没有「该复习的」卡片（要么都还很新，要么还没看过任何卡）。")
            return
        order = [c for c in cards if c["name"] in due]
        print("↻ 该复习 %d 张：%s" % (len(order), "、".join(c["name"] for c in order)))
        P.browse(order, 0, cards)
        return

    if not pos:
        strength = P.load_strength()
        print("ibox learn · 按功能域学习（共 %d 张）" % len(cards))
        print()
        total_seen = 0
        for i, cat in enumerate(CATEGORY_ORDER, 1):
            names = [c["name"] for c in cards if c.get("分类") == cat]
            if not names:
                continue
            seen = sum(1 for n in names if strength.get(n, {}).get("count", 0) > 0)
            total_seen += seen
            bar = "█" * seen + "·" * (len(names) - seen)
            print("  %d. %-16s %s  %d/%d" % (i, cat, bar, seen, len(names)))
        print()
        print("  总进度 %d/%d" % (total_seen, len(cards)))
        print()
        print("  看某一类：ibox learn <分类名>（可只写关键词，如 `ibox learn 网络`）")
        print("  只看该复习的：ibox learn --due")
        return

    want = pos[0]
    if want not in CATEGORY_ORDER:
        hits = [c for c in CATEGORY_ORDER if want in c]
        if len(hits) != 1:
            print("⚠️ 未知分类「%s」；可选：%s" % (want, " / ".join(CATEGORY_ORDER)))
            return
        want = hits[0]
    order = [c for c in cards if c.get("分类") == want]
    if not order:
        print("（「%s」暂无卡片）" % want)
        return
    print("开始学习「%s」（%d 张）：n/→ 下一张 · p/← 上一张 · c 复制示例 · q 退出" % (want, len(order)))
    P.browse(order, 0, cards)


