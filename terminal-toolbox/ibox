# ============ 入口 ============
_KNOWN = ("how", "find", "add", "done", "ask", "hi", "sync", "card", "learn", "help")


def main():
    argv = sys.argv[1:]
    if not argv:
        show_guide()
        return
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        show_guide()
        return
    if cmd not in _KNOWN:
        # 不是子命令 → 整体当作 how 查询，兼容 `c 端口占用` 的肌肉记忆
        cmd, rest = "how", argv
    if cmd == "how":
        cmd_how(rest)
    elif cmd == "find":
        cmd_find(rest)
    elif cmd == "add":
        cmd_add(rest)
    elif cmd == "done":
        cmd_done(rest)
    elif cmd == "ask":
        cmd_ask(rest)
    elif cmd == "hi":
        cmd_hi(rest)
    elif cmd == "sync":
        cmd_sync(rest)
    elif cmd == "card":
        cmd_card(rest)
    elif cmd == "learn":
        cmd_learn(rest)


if __name__ == "__main__":
    main()
